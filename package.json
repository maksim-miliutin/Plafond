{
    "name": "plafond",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/domain",
        "packages/import",
        "packages/address",
        "packages/ademe",
        "apps/web"
    ],
    "scripts": {
        "test": "vitest run",
        "build": "npm run build --workspaces",
        "dev": "npm run build -w @plafond/domain -w @plafond/import -w @plafond/address && npm run dev -w @plafond/web"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^5.0.2"
    }
}
